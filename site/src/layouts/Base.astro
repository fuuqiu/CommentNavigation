---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { APP, AUTHOR, HTML_LANG, OG_LOCALE, ROUTES, absolute, ui, type Lang, type RouteKey } from '../i18n';

/**
 * The only place the <head> is written. Every page goes through here, so the SEO
 * red line (title + description + canonical + hreflang + OG + JSON-LD) either holds
 * for the whole site or fails visibly on every page at once.
 */
interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  /** JSON-LD nodes, each serialised into its own application/ld+json script. */
  jsonLd?: Record<string, unknown>[];
  /** Error pages stay out of the index and carry no hreflang. */
  noindex?: boolean;
}

const { lang, route, title, description, jsonLd = [], noindex } = Astro.props;

// Astro.site comes from astro.config.mjs (SITE_URL at build time). It is always set
// there, so the non-null assertion cannot fire in a real build.
const site = Astro.site!;
const canonical = absolute(noindex ? '/404.html' : ROUTES[route][lang], site);
const ogImage = absolute('/og.png', site);
const t = ui[lang];

// Both languages plus x-default, on every indexable page. Google needs the set to be
// reciprocal — that is why the pairs come from ROUTES rather than being written here.
const alternates = [
  { hreflang: HTML_LANG.en, href: absolute(ROUTES[route].en, site) },
  { hreflang: HTML_LANG.zh, href: absolute(ROUTES[route].zh, site) },
  { hreflang: 'x-default', href: absolute(ROUTES[route].en, site) },
];
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <Fragment>
        {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
      </Fragment>
    )}

    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={AUTHOR} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={lang === 'en' ? OG_LOCALE.zh : OG_LOCALE.en} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogImageAlt} />

    {jsonLd.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
